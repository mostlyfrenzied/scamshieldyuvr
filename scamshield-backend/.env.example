# Local development only. On Render, add these in Dashboard > Environment.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/scamshield
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
# Comma-separated exact origins. Example: http://localhost:5500,https://YOUR-GITHUB-USERNAME.github.io
CORS_ORIGIN=http://localhost:5500
# Optional: enables Google Safe Browsing URL reputation lookups.
GOOGLE_SAFE_BROWSING_API_KEY=
